# Скопируйте в .env. Секретов продакшена здесь нет.
# Пароли держите URL-safe: без @ : / # $ и пробелов — они попадают в DATABASE_URL.

# --- Обязательные для запуска ---
POSTGRES_USER=invoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoice_keeper
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://invoice:change-me@localhost:5432/invoice_keeper

# Владелец установки. OWNER_* — канон. ADMIN_* — тот же человек, если OWNER_* пустые.
OWNER_EMAIL=admin@invoice.local
OWNER_PASSWORD=change-me
OWNER_NAME=Админ
ADMIN_EMAIL=admin@invoice.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Админ

SECRET_KEY=change-me-not-a-secret
TIMEZONE=Europe/Moscow
SOON_DAYS=3
HORIZON_MONTHS=2
SESSION_DAYS=14

# Пустой DOMAIN — панель по HTTP на HTTP_PORT. Для жюри так и оставьте.
# Сервер с доменом: DOMAIN=rekeeper.ru, HTTP_PORT=80, HTTPS_PORT=443, ACME_EMAIL=...
DOMAIN=
HTTP_PORT=8080
HTTPS_PORT=8443
ACME_EMAIL=
API_PORT=8000
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# Демо-отделы и платежи кейса, только на пустой базе (отделов ещё нет).
SEED_DEMO=true
# Показать на странице входа почту и пароль. Для жюри оставьте true.
# На сервере с живыми людьми — false: GET /api/v1/public-config без сессии отдаёт пароли.
SHOW_DEMO_CREDENTIALS=true
DEMO_USER_EMAIL=ivan@invoice.local
DEMO_USER_NAME=Иван Петров
DEMO_USER_TWO_EMAIL=maria@invoice.local
DEMO_USER_TWO_NAME=Мария Соколова
DEMO_USER_PASSWORD=change-me-user

WORKER_INTERVAL_SECONDS=60
BACKUP_KEEP=7

# IPv6 у сети compose. false — машины без IPv6 не ломаются.
# На Aeza, где Telegram доступен только по IPv6: true и TELEGRAM_NETWORK=ipv6.
ENABLE_IPV6=false

# --- Необязательные. Пустое значение выключает канал, остальное работает. ---

# Профиль compose. Пусто — контейнер assistant не создаётся.
# Вместе с ключом GigaChat: COMPOSE_PROFILES=assistant
COMPOSE_PROFILES=

# Telegram. Токен из BotFather. Имя бота для t.me берётся из getMe.
# TELEGRAM_NETWORK: auto (сначала IPv6, потом IPv4), ipv4 или ipv6.
# TELEGRAM_PROXY — необязательный HTTP(S)-прокси, например http://host.docker.internal:1080
# TELEGRAM_BOT_USERNAME — запас, если бот ещё не записал getMe.
# TELEGRAM_CHAT_ID — запасной чат, только когда отдел в базе один.
# TELEGRAM_FORCE_IPV6=true — устаревший алиас сети ipv6.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NETWORK=auto
TELEGRAM_PROXY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_FORCE_IPV6=false

# Почта. Без SMTP_HOST коды сброса пишутся в лог API, панель жива.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=true

# Webhook установки. Командный URL задаётся в вебе.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_ATTEMPTS=3
WEBHOOK_BACKOFF_SECONDS=0.4

# Ассистент. Пустой ключ — сервиса нет, в интерфейсе и в боте его нет.
# Ключ задан и COMPOSE_PROFILES=assistant — ассистент в вебе и в боте.
# Голос включается только вместе с ассистентом, когда заданы оба поля SpeechKit.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_FALLBACK_MODEL=GigaChat-2-Pro
YANDEX_SPEECHKIT_API_KEY=
YANDEX_FOLDER_ID=
