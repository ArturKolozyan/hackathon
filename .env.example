# Скопируйте в .env и при желании смените. Это демо-значения, не секреты продакшена.
# Пароли держите URL-safe: без @ : / # $ и пробелов — они попадают в DATABASE_URL.

POSTGRES_USER=invoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoice_keeper
# Хостовый порт. Compose вешает его только на 127.0.0.1, не на 0.0.0.0.
POSTGRES_PORT=5432

# Для alembic/pytest на хосте. Compose внутри сети подменяет хост на db.
DATABASE_URL=postgresql+psycopg://invoice:change-me@localhost:5432/invoice_keeper

# Демо-владелец «Студии Север». Пароль пишется только в пустую базу при SEED_DEMO=true.
# Рестарт API его больше не перезаписывает. На проде с живыми людьми сид не запускается.
ADMIN_EMAIL=admin@invoice.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Админ

DEMO_USER_EMAIL=ivan@invoice.local
DEMO_USER_NAME=Иван Петров
DEMO_USER_TWO_EMAIL=maria@invoice.local
DEMO_USER_TWO_NAME=Мария Соколова
DEMO_USER_THREE_EMAIL=oleg@invoice.local
DEMO_USER_THREE_NAME=Олег Смирнов
DEMO_USER_PASSWORD=change-me-user
SEED_DEMO=true

SECRET_KEY=change-me-not-a-secret
TIMEZONE=Europe/Moscow
SOON_DAYS=3
HORIZON_MONTHS=2
SESSION_DAYS=14
# Локальный HTTP (localhost:8080): false, иначе браузер не сохранит куку.
# Прод — в серверном .env, этот файл туда не копируется сам:
#   COOKIE_SECURE=true
#   CORS_ORIGINS=https://rekeeper.ru
# UI и /api на одном origin, браузеру CORS для сайта не нужен.
# www.rekeeper.ru в CORS не добавлять: он отвечает 301 на apex и приложение не отдаёт.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Канонический адрес. Письмо-напоминание дописывает его отдельной строкой.
# Пусто или без http(s):// — строка не добавляется. Карточка Telegram ссылку не содержит.
APP_PUBLIC_URL=https://rekeeper.ru
WORKER_INTERVAL_SECONDS=60

# Оба порта на хосте только 127.0.0.1. Снаружи приложение открывает Caddy (80/443).
API_PORT=8000
# Аварийный nginx на самом VPS и health деплоя. На VPS оставить 8080.
WEB_PORT=8080
# На VPS не задавать: Caddy должен занять хостовые 80 и 443.
# Локально, если порты заняты: CADDY_HTTP_PORT=9080 и CADDY_HTTPS_PORT=9443.
# COMPOSE_FILE и COMPOSE_PROFILES на VPS не задавать. Деплой передаёт -f сам.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# Бот в worker: long polling. Токен из BotFather, в git не класть.
# Чат команды и личные аккаунты привязываются в вебе (Настройки). Пустой токен — канал молчит, API жив.
# TELEGRAM_CHAT_ID — запасной числовой id (у группы обычно отрицательный), только если команда одна и в базе чата ещё нет.
# Явное «Отключить» в вебе этот запасной чат глушит. Пустой chat id — нормальный запуск.
# VPS в Москве: IPv4 до api.telegram.org таймаутится. true сажает сокет на :: (IPv6).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_FORCE_IPV6=true

# Напоминания воркера: EMAIL_ENABLED=true и SMTP_HOST, SMTP_FROM, SMTP_TO. Иначе тишина.
# Коды регистрации, сброс пароля и приглашения SMTP_TO не используют и не смотрят на EMAIL_ENABLED.
# Им нужны SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM, SMTP_TLS.
# Пустой SMTP_HOST — код пишется в лог API (dev). Отправка в фоне, таймаут сокета 15 с.
# Прод: smtp.beget.com:2525 и SMTP_TLS=true. Порт 465 с VPS недоступен.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=true

# Webhook: occurrence.reminder, occurrence.paid, occurrence.unpaid.
# Если задан WEBHOOK_SECRET, тело подписывается HMAC-SHA256 в X-Rekeeper-Signature.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_ATTEMPTS=3
WEBHOOK_BACKOFF_SECONDS=0.4
