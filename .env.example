# Скопируйте в .env и при желании смените. Это демо-значения, не секреты продакшена.
# Пароли держите URL-safe: без @ : / # $ и пробелов — они попадают в DATABASE_URL.

POSTGRES_USER=invoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoice_keeper
POSTGRES_PORT=5432

# Для alembic/pytest на хосте. Compose внутри сети подменяет хост на db.
DATABASE_URL=postgresql+psycopg://invoice:change-me@localhost:5432/invoice_keeper

ADMIN_EMAIL=admin@invoice.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Админ

DEMO_USER_EMAIL=ivan@invoice.local
DEMO_USER_NAME=Иван Петров
DEMO_USER_TWO_EMAIL=maria@invoice.local
DEMO_USER_TWO_NAME=Мария Соколова
DEMO_USER_PASSWORD=change-me-user
SEED_DEMO=true

SECRET_KEY=change-me-not-a-secret
TIMEZONE=Europe/Moscow
SOON_DAYS=3
HORIZON_MONTHS=2
SESSION_DAYS=14
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WORKER_INTERVAL_SECONDS=60

API_PORT=8000
WEB_PORT=8080

# Бот в worker: long polling, не webhook. Реальный токен в git не класть.
# Пустые token/chat — worker только держит горизонт периодов и пишет в лог, что Telegram пропущен.
# VPS в Москве: IPv4 до api.telegram.org таймаутится. true сажает сокет на :: (IPv6).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_FORCE_IPV6=true
